# Keep editors consistent across machines. Prettier is not enforced in CI (the
# existing style is hand-formatted), so these rules only cover the invisible
# whitespace that Git and ESLint care about.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{json,yml,yaml}]
indent_size = 2
