{
  "name": "pku-swm-420-study-system",
  "version": "4.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-local.ps1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "clean": "node scripts/clean.mjs",
    "check": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "deploy:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-all.ps1",
    "deploy:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-all.ps1 -Production",
    "verify:production": "node scripts/verify-production.mjs",
    "quality": "npm run check && npm run typecheck && npm run test:palette && npm run test:boundaries && npm run test:css-debt && npm test && npm run test:browser && npm run build && npm run test:budget && npm run test:csp && npm audit --audit-level=moderate",
    "test": "vitest --run",
    "test:browser": "node scripts/verify-local.mjs",
    "test:budget": "node scripts/verify-budget.mjs",
    "test:boundaries": "node scripts/verify-module-boundaries.mjs",
    "test:css-debt": "node scripts/verify-css-debt.mjs",
    "test:csp": "node scripts/verify-csp.mjs",
    "test:coverage": "vitest --run --coverage",
    "test:study-plan-ui": "node scripts/verify-study-plan-ui.mjs",
    "test:palette": "node scripts/verify-no-green.mjs",
    "test:watch": "vitest",
    "test:props": "vitest --run tests/properties"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "lucide": "^1.47.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
